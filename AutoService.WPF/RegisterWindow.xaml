<Window x:Class="AutoService.WPF.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="700" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        TextElement.FontFamily="Segoe UI"
        ResizeMode="NoResize"
        Icon="logo.png">

    <Grid Margin="40">
        <StackPanel VerticalAlignment="Center">
            <Grid Height="70" Margin="0,0,0,5">
                <Image Source="logo.png" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Text="AutoExp" FontSize="36" FontWeight="Bold" Foreground="{StaticResource NeonCyan}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="Создайте аккаунт для записи" FontSize="14" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="ФИО" Foreground="White" Margin="0,0,0,5"/>
            <TextBox x:Name="TbFio" Background="{StaticResource CardBackground}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Padding="10" FontSize="16" Margin="0,0,0,10"/>

            <TextBlock Text="Телефон" Foreground="White" Margin="0,0,0,5"/>
            <TextBox x:Name="TbPhone" Background="{StaticResource CardBackground}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Padding="10" FontSize="16" Margin="0,0,0,10"/>

            <TextBlock Text="Логин" Foreground="White" Margin="0,0,0,5"/>
            <TextBox x:Name="TbLogin" Background="{StaticResource CardBackground}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Padding="10" FontSize="16" Margin="0,0,0,10"/>

            <TextBlock Text="Пароль" Foreground="White" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PbPassword" Background="{StaticResource CardBackground}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Padding="10" FontSize="16" Margin="0,0,0,20"/>

            <Button Content="Создать аккаунт" Click="BtnRegister_Click" Style="{StaticResource NeonButton}" Height="45"/>
            <Button Content="Отмена" Click="BtnCancel_Click" Style="{StaticResource NeonButton}" Height="45" Margin="0,10,0,0" Background="{StaticResource BorderColor}" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>