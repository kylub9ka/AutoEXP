<Window x:Class="AutoService.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="650" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        TextElement.FontFamily="Segoe UI"
        ResizeMode="NoResize"
        Icon="logo.png">

    <Grid Margin="40">
        <StackPanel VerticalAlignment="Center">
            <Grid Height="80" Margin="0,0,0,5">
                <Image Source="logo.png" Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Text="AutoExp" FontSize="48" FontWeight="Bold" Foreground="{StaticResource NeonCyan}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Вход в систему" FontSize="18" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Логин" Foreground="White" Margin="0,0,0,5"/>
            <TextBox x:Name="TbLogin" Background="{StaticResource CardBackground}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Padding="10" FontSize="16" Text="admin" Margin="0,0,0,15"/>

            <TextBlock Text="Пароль" Foreground="White" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PbPassword" Background="{StaticResource CardBackground}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Padding="10" FontSize="16" Password="123"/>

            <Button Content="Войти" Click="BtnLogin_Click" Style="{StaticResource NeonButton}" Height="45" Margin="0,30,0,0"/>

            <Button Content="Зарегистрироваться" Click="BtnRegister_Click" 
                    Style="{StaticResource NeonButton}" Height="45" Margin="0,15,0,0"
                    Background="Transparent" Foreground="{StaticResource NeonCyan}" 
                    BorderBrush="{StaticResource NeonCyan}" BorderThickness="2"/>
        </StackPanel>
    </Grid>
</Window>