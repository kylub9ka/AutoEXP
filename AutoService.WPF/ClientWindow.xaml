<Window x:Class="AutoService.WPF.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoPRO - Личный кабинет" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        TextElement.FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid Margin="30,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚗" FontSize="30" Foreground="{StaticResource NeonCyan}" VerticalAlignment="Center"/>
                    <TextBlock Text="Личный кабинет клиента" FontSize="24" FontWeight="Bold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="Выйти" Click="BtnLogout_Click" HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Style="{StaticResource NeonButton}" Width="100" Background="{StaticResource NeonPink}" Foreground="White"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="30">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="20,10" Margin="0,0,10,0">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NeonCyan}"/>
                                            <Setter Property="Foreground" Value="{StaticResource NeonCyan}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="FontSize" Value="18"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="Мои заказы">
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="350"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Мои заказы" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                                <DataGrid x:Name="MyOrdersGrid" Grid.Row="1" Style="{StaticResource ModernDataGrid}"
                                          CanUserResizeColumns="False" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Disabled">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="№" Binding="{Binding kod_zakaza}" Width="50"/>
                                        <DataGridTextColumn Header="Услуга" Binding="{Binding usluga}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Авто" Binding="{Binding avto}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Цена" Binding="{Binding cena, StringFormat={}{0:N0} ₽}" Width="90" Foreground="{StaticResource NeonCyan}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Статус" Binding="{Binding status}" Width="130">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Записаться на ремонт" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                                <TextBlock Text="Марка авто" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,0,2"/>
                                <TextBox x:Name="TbMarka" Background="{StaticResource CardBackground}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Padding="8" Margin="0,0,0,8" Text="Lada"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="Госномер" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TbGosnomer" Background="{StaticResource CardBackground}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Padding="8" Margin="0,0,0,8" Text="А123ВС76"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="Год выпуска" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TbGod" Background="{StaticResource CardBackground}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Padding="8" Margin="0,0,0,8" Text="2020"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Услуги (Ctrl + клик)" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,5,0,2"/>
                                <ListBox x:Name="LbService" DisplayMemberPath="Name" SelectionMode="Multiple" Background="{StaticResource CardBackground}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Padding="5" Height="100" Margin="0,0,0,15"/>

                                <Button Content="Записаться" Click="BtnBook_Click" Style="{StaticResource NeonButton}" Height="40"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Акции и скидки">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                        <StackPanel x:Name="PromotionsPanel"/>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Мастера и Отзывы">
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Наши мастера" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                                <DataGrid x:Name="MastersGrid" Grid.Row="1" Style="{StaticResource ModernDataGrid}" CanUserResizeColumns="False" CanUserReorderColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ФИО" Binding="{Binding fio}" Width="*"/>
                                        <DataGridTextColumn Header="Специальность" Binding="{Binding spec}" Width="*" Foreground="{StaticResource NeonCyan}"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="2" Margin="0,15,0,0">
                                    <TextBlock Text="Оставить отзыв о мастере" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                    <ComboBox x:Name="CbReviewMaster" DisplayMemberPath="Name" SelectedValuePath="Id" Background="{StaticResource CardBackground}" Foreground="White" Padding="8" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="Оценка (1-5)" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,2"/>
                                            <TextBox x:Name="TbOcenka" Background="{StaticResource CardBackground}" Foreground="White" Padding="8" Text="5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                            <TextBlock Text="Текст отзыва" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,2"/>
                                            <TextBox x:Name="TbReviewText" Background="{StaticResource CardBackground}" Foreground="White" Padding="8" Text="Отличная работа!"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button Content="Отправить отзыв" Click="BtnSendReview_Click" Style="{StaticResource NeonButton}" Height="35"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Последние отзывы" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="ReviewsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding master}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource NeonCyan}" TextTrimming="CharacterEllipsis"/>
                                                            <Border Grid.Column="1" Background="Transparent" BorderBrush="{StaticResource NeonPink}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                                <TextBlock Text="{Binding ocenka}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource NeonPink}"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{Binding text}" Foreground="{StaticResource TextMain}" FontSize="14" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding data}" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>